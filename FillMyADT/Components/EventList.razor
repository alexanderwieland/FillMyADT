@if (IsLoading)
{
    <div class="loading-container">
        <div class="spinner"></div>
        <p>Loading events...</p>
    </div>
}
else if (Events == null || !Events.Any())
{
    <div class="no-events">
        <p>No events found for the selected date.</p>
    </div>
}
else
{
    <div class="event-list">
        <h3>Events Timeline (@Events.Count events)</h3>

        <div class="events">
            @foreach (var evt in Events)
            {
                var sourcePresentation = GetSourcePresentation(evt.Source);
                <div class="event-item @GetEventClass(evt.EventType) @sourcePresentation.CssClass">
                    <div class="event-time">
                        @evt.Timestamp.ToString("HH:mm:ss")
                    </div>
                    <div class="event-source-badge">
                        @sourcePresentation.Badge
                    </div>
                    <div class="event-details">
                        <div class="event-type">@evt.EventType</div>
                        <div class="event-description">@evt.Description</div>
                        @if (evt.Metadata != null && evt.Metadata.Any())
                        {
                            <div class="event-metadata">
                                @if (evt.Metadata.TryGetValue("TicketNumber", out var ticket))
                                {
                                    <span class="metadata-item ticket-number">#@ticket</span>
                                }
                                @if (evt.Metadata.TryGetValue("Branch", out var branch))
                                {
                                    <span class="metadata-item branch-name">@branch</span>
                                }
                                @if (evt.Metadata.TryGetValue("Repository", out var repo))
                                {
                                    <span class="metadata-item repo-name">@repo</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<Event>? Events { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    private static string GetEventClass(EventType eventType) =>
        eventType switch
        {
            // Windows power events
            EventType.Boot => "event-boot",
            EventType.Shutdown => "event-shutdown",

            // Git events
            EventType.Commit => "event-commit",
            EventType.BranchSwitch => "event-branch",

            // Review as part of work
            EventType.ReviewStart => "event-review",
            EventType.ReviewEnd => "event-review",

            // Meetings
            EventType.CalendarMeetingStart => "event-meeting",
            EventType.CalendarMeetingEnd => "event-meeting",

            // Tickets
            EventType.TicketStart => "event-ticket",
            EventType.TicketEnd => "event-ticket",

            // Break
            EventType.LunchBreakStart => "event-break",
            EventType.LunchBreakEnd => "event-break",

            // Whole day specials
            EventType.SpecialWholeDayHoliday => "event-holiday",
            EventType.SpecialWholeDayZeitausgleich => "event-zeitausgleich",
            EventType.SpecialWholeDayHomeoffice => "event-homeoffice",

            _ => "event-other"
        };


    private static (string CssClass, string Badge) GetSourcePresentation(string source)
    {
        if (source.Contains("Git History", StringComparison.OrdinalIgnoreCase))
        {
            var parts = source.Split(" - ", 2);
            return ("source-git", parts.Length > 1 ? parts[1] : "Git");
        }

        return source.Contains("Windows", StringComparison.OrdinalIgnoreCase)
            ? ("source-windows", "Windows")
            : ("source-other", source);
    }
}

<style>
    .event-list {
        margin-top: 10px;
    }

    .event-list h3 {
        margin: 0 0 10px 0;
        font-size: 1.2rem;
    }

    .events {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-top: 8px;
    }

    .event-item {
        display: flex;
        gap: 10px;
        padding: 8px 10px;
        background-color: white;
        border-left: 3px solid #6c757d;
        border-radius: 3px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.08);
    }

    .event-time {
        font-weight: bold;
        color: #495057;
        min-width: 70px;
        font-family: 'Consolas', monospace;
        font-size: 12px;
    }

    .event-source-badge {
        font-size: 10px;
        font-weight: 600;
        padding: 3px 8px;
        border-radius: 10px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        white-space: nowrap;
        align-self: flex-start;
    }

    .source-git .event-source-badge {
        background-color: #28a745;
        color: white;
    }

    .source-windows .event-source-badge {
        background-color: #0078d4;
        color: white;
    }

    .source-other .event-source-badge {
        background-color: #6c757d;
        color: white;
    }

    .source-git {
        border-left-color: #28a745;
        background-color: #f8fff9;
    }

    .source-windows {
        border-left-color: #0078d4;
        background-color: #f0f8ff;
    }

    .event-details {
        flex: 1;
    }

    .event-type {
        font-weight: 600;
        color: #212529;
        margin-bottom: 2px;
        font-size: 13px;
    }

    .event-description {
        color: #6c757d;
        font-size: 12px;
        margin-bottom: 4px;
        line-height: 1.3;
    }

    .event-metadata {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        font-size: 11px;
    }

    .metadata-item {
        background-color: #e9ecef;
        padding: 2px 6px;
        border-radius: 2px;
        color: #495057;
    }

    .metadata-item.ticket-number {
        background-color: #ffc107;
        color: #000;
        font-weight: 600;
        font-size: 11px;
    }

    .metadata-item.branch-name {
        background-color: #17a2b8;
        color: white;
        font-weight: 500;
    }

    .metadata-item.repo-name {
        background-color: #6c757d;
        color: white;
        font-weight: 500;
    }

	/* Compact single-line rows */
	.event-item { display: flex; align-items: center; gap: 8px; padding: 3px 8px; margin-bottom: 2px; min-height: 0; }
	.event-time, .event-source-badge { white-space: nowrap; flex-shrink: 0; }
	.event-details { display: flex; align-items: center; gap: 6px; flex: 1; min-width: 0; overflow: hidden; }
	.event-type { white-space: nowrap; flex-shrink: 0; margin: 0; }
	.event-description { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; flex: 1; margin: 0; }
	.event-metadata { display: flex; flex-wrap: nowrap; gap: 4px; margin: 0; flex-shrink: 0; }
	.metadata-item { padding: 1px 6px; font-size: 0.75em; white-space: nowrap; }
</style>
