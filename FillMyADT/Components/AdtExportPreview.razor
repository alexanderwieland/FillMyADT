@using FillMyADT.Models

@if (IsLoading)
{
    <div class="loading-container">
        <div class="spinner"></div>
        <p>Loading export preview...</p>
    </div>
}
else if (ExportEntries == null || !ExportEntries.Any())
{
    <div class="no-exports">
        <p>No entries to export for the selected date.</p>
        @if (ExcludedCount > 0)
        {
            <p class="excluded-note">ℹ️ @ExcludedCount time slot(s) excluded (breaks are not exported)</p>
        }
    </div>
}
else
{
    <div class="export-preview">
        <h3>ADT Export Preview (@ExportEntries.Count entries, @FormatTotalDuration(ExportEntries) total)</h3>
        @if (ExcludedCount > 0)
        {
            <div class="excluded-info">
                ℹ️ @ExcludedCount time slot(s) excluded from export (breaks)
            </div>
        }

        <div class="export-entries">
            @for (int i = 0; i < ExportEntries.Count; i++)
            {
                var entry = ExportEntries[i];
                var isFirst = i == 0;
                var isLast = i == ExportEntries.Count - 1;

                <div class="export-item">
                    <div class="merge-buttons">
                        <button class="btn-merge btn-merge-up"
                                @onclick="() => OnMergeAbove.InvokeAsync(entry)"
                                disabled="@isFirst"
                                title="Merge with above">
                            ▲
                        </button>
                        <button class="btn-merge btn-merge-down"
                                @onclick="() => OnMergeBelow.InvokeAsync(entry)"
                                disabled="@isLast"
                                title="Merge with below">
                            ▼
                        </button>
                    </div>
                    <span class="time">@entry.Beginn - @entry.Ende (@entry.FormattedDauer)</span>
                    <span class="divider">|</span>
                    <span class="bereich">@entry.Bereich</span>
                    <span class="divider">|</span>
                    <span class="ort">@entry.Ort</span>
                    <span class="divider">|</span>
                    <span class="betrieb">@entry.Betrieb</span>
                    <span class="divider">|</span>
                    <span class="projekt">@entry.Projekt</span>
                    <span class="divider">|</span>
                    <span class="doku">@(string.IsNullOrEmpty(entry.Dokumentation) ? "(empty)" : entry.Dokumentation)</span>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<AdtExportEntry>? ExportEntries { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public int ExcludedCount { get; set; }

    [Parameter]
    public EventCallback<AdtExportEntry> OnMergeAbove { get; set; }

    [Parameter]
    public EventCallback<AdtExportEntry> OnMergeBelow { get; set; }

    private static string FormatTotalDuration(IReadOnlyList<AdtExportEntry> entries)
    {
        var totalHours = entries.Sum(e => e.Dauer);
        var hours = (int)totalHours;
        var minutes = (int)((totalHours - hours) * 60);

        if (hours > 0)
        {
            return minutes > 0 ? $"{hours}h {minutes}m" : $"{hours}h";
        }
        return $"{minutes}m";
    }
}

<style>
    .export-preview {
        margin-top: 10px;
    }

    .export-preview h3 {
        margin: 0 0 10px 0;
        font-size: 1.2rem;
    }

    .excluded-info {
        background-color: #fff3cd;
        border-left: 3px solid #ffc107;
        padding: 8px 12px;
        margin-bottom: 10px;
        border-radius: 3px;
        font-size: 12px;
        color: #856404;
    }

    .export-entries {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-top: 8px;
    }

    .export-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        background-color: white;
        border-left: 3px solid #dee2e6;
        border-radius: 3px;
        font-size: 12px;
        line-height: 1.4;
    }

        .export-item:hover {
            background-color: #f8f9fa;
        }

    .merge-buttons {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .btn-merge {
        width: 20px;
        height: 16px;
        padding: 0;
        border: 1px solid #ced4da;
        background-color: white;
        color: #495057;
        font-size: 10px;
        border-radius: 2px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
    }

        .btn-merge:hover:not(:disabled) {
            background-color: #0078d4;
            color: white;
            border-color: #0078d4;
        }

        .btn-merge:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

    .time {
        font-family: 'Consolas', monospace;
        font-weight: 600;
        color: #495057;
        min-width: 120px;
    }

    .divider {
        color: #dee2e6;
    }

    .ort {
        font-weight: 600;
        color: #495057;
        min-width: 40px;
    }

    .betrieb {
        color: #495057;
        min-width: 50px;
    }

    .bereich {
        color: #495057;
        min-width: 40px;
    }

    .projekt {
        font-family: 'Consolas', monospace;
        color: #0078d4;
        font-weight: 500;
        min-width: 150px;
    }

    .doku {
        color: #212529;
        flex: 1;
    }

    .no-exports {
        padding: 20px;
        text-align: center;
        color: #6c757d;
        font-size: 13px;
    }

    .excluded-note {
        margin-top: 8px;
        font-size: 12px;
        color: #856404;
    }

    .loading-container {
        padding: 40px 20px;
        text-align: center;
        color: #6c757d;
    }

        .loading-container p {
            margin-top: 15px;
            font-size: 13px;
        }

    .spinner {
        border: 3px solid #f3f3f3;
        border-top: 3px solid #0078d4;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        margin: 0 auto;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>
