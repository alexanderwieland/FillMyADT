@page "/"
@using FillMyADT.Services
@using FillMyADT.Models
@inject EventAggregatorService EventAggregator
@inject EventToTimeSpanConverter TimeSlotConverter
@inject AdtXmlExportService AdtExportService
@inject ClipboardFormatterService ClipboardFormatter
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="home-container">
    <h1>Daily Activity Tracker</h1>
    <p>Track your daily activities from Windows events and Git history</p>

    <div class="controls">
        <!-- Date Navigation Section -->
        <div class="date-section">
            <button class="nav-arrow" @onclick="LoadPreviousDayAsync" title="Previous Day">
                ◀
            </button>
            <input type="date"
                   @bind="selectedDate"
                   @bind:after="LoadEventsAsync"
                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                   class="date-input" />
            <button class="nav-arrow" @onclick="LoadNextDayAsync" title="Next Day" disabled="@(selectedDate >= DateTime.Today)">
                ▶
            </button>
            <button class="quick-date-btn" @onclick="LoadYesterdayAsync" title="Yesterday">Yesterday</button>
            <button class="quick-date-btn" @onclick="LoadTodayAsync" title="Today">Today</button>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
            <button class="btn btn-refresh" @onclick="LoadEventsAsync" disabled="@isLoading">
                @(isLoading ? "Loading..." : "🔄 Refresh")
            </button>
            <button class="btn btn-copy" @onclick="CopyEventsAsync" disabled="@(events == null || !events.Any())" title="Copy Events to Clipboard">
                📋 Copy Events
            </button>
            <button class="btn btn-copy" @onclick="CopyTimeSlotsAsync" disabled="@(timeSlots == null || !timeSlots.Any())" title="Copy Time Slots to Clipboard">
                ⏱️ Copy Slots
            </button>
            <button class="btn btn-export" @onclick="ExportToAdtAsync" disabled="@(timeSlots == null || !timeSlots.Any())" title="Export to ADT XML">
                📤 Export to ADT
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-message">
            @errorMessage
        </div>
    }

    @if (availableSources != null && availableSources.Any())
    {
        <div class="sources-info">
            <strong>Active Sources:</strong> @string.Join(", ", availableSources)
        </div>
    }

    <div class="view-switcher">
        <button class="view-btn @(currentView == ViewMode.Events ? "active" : "")" @onclick="() => SwitchView(ViewMode.Events)">
            📋 Events
        </button>
        <button class="view-btn @(currentView == ViewMode.TimeSlots ? "active" : "")" @onclick="() => SwitchView(ViewMode.TimeSlots)">
            ⏱️ Time Slots
        </button>
        <button class="view-btn @(currentView == ViewMode.ExportPreview ? "active" : "")" @onclick="() => SwitchView(ViewMode.ExportPreview)">
            📤 Export Preview
        </button>
    </div>

    @if (currentView == ViewMode.Events)
    {
        <EventList Events="@events" IsLoading="@isLoading" />
    }
    else if (currentView == ViewMode.TimeSlots)
    {
        <TimeSlotList TimeSlots="@timeSlots" IsLoading="@isLoading" />
    }
    else
    {
        <AdtExportPreview
            ExportEntries="@exportPreview"
            IsLoading="@isLoading"
            ExcludedCount="@excludedCount"
            OnMergeAbove="@MergeWithAbove"
            OnMergeBelow="@MergeWithBelow" />
    }
</div>

@code {
    private enum ViewMode { Events, TimeSlots, ExportPreview }

    private DateTime selectedDate = DateTime.Today.AddDays(-1); // Start with yesterday
    private IReadOnlyList<Event>? events;
    private IReadOnlyList<TimeSlot>? timeSlots;
    private IReadOnlyList<AdtExportEntry>? exportPreview;
    private int excludedCount;
    private IEnumerable<string>? availableSources;
    private bool isLoading;
    private string? errorMessage;
    private CancellationTokenSource? _loadCancellationTokenSource;
    private ViewMode currentView = ViewMode.ExportPreview;

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableSourcesAsync();
        await LoadEventsAsync();
    }

    private async Task LoadAvailableSourcesAsync()
    {
        try
        {
            availableSources = await EventAggregator.GetAvailableSourcesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading sources: {ex.Message}");
        }
    }

    private async Task LoadEventsAsync()
    {
        _loadCancellationTokenSource?.Cancel();
        _loadCancellationTokenSource?.Dispose();
        _loadCancellationTokenSource = new CancellationTokenSource();

        var cancellationToken = _loadCancellationTokenSource.Token;

        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            events = await EventAggregator.GetEventsForDayAsync(selectedDate, cancellationToken);

            // Convert events to time slots
            if (events != null && events.Any())
            {
                timeSlots = await TimeSlotConverter.ConvertEventsToTimeSlotsAsync(events, cancellationToken);

                // Generate export preview
                exportPreview = AdtExportService.GetExportPreview(timeSlots, selectedDate);
                excludedCount = timeSlots.Count(ts => ts.Category == TimeSlotCategory.Break);
            }
            else
            {
                timeSlots = Array.Empty<TimeSlot>();
                exportPreview = Array.Empty<AdtExportEntry>();
                excludedCount = 0;
            }
        }
        catch (OperationCanceledException)
        {
            // Cancelled - don't show error
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading events: {ex.Message}";
            events = Array.Empty<Event>();
            timeSlots = Array.Empty<TimeSlot>();
            exportPreview = Array.Empty<AdtExportEntry>();
            excludedCount = 0;
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested)
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadTodayAsync()
    {
        selectedDate = DateTime.Today;
        await LoadEventsAsync();
    }

    private async Task LoadYesterdayAsync()
    {
        selectedDate = DateTime.Today.AddDays(-1);
        await LoadEventsAsync();
    }

    private async Task LoadPreviousDayAsync()
    {
        selectedDate = selectedDate.AddDays(-1);
        await LoadEventsAsync();
    }

    private async Task LoadNextDayAsync()
    {
        if (selectedDate < DateTime.Today)
        {
            selectedDate = selectedDate.AddDays(1);
            await LoadEventsAsync();
        }
    }

    private void SwitchView(ViewMode mode)
    {
        currentView = mode;
    }

    private async Task CopyEventsAsync()
    {
        if (events == null || !events.Any())
            return;

        try
        {
            var text = ClipboardFormatter.FormatEvents(events, selectedDate);
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to copy to clipboard: {ex.Message}";
        }
    }

    private async Task CopyTimeSlotsAsync()
    {
        if (timeSlots == null || !timeSlots.Any())
            return;

        try
        {
            var text = ClipboardFormatter.FormatTimeSlots(timeSlots, selectedDate);
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to copy to clipboard: {ex.Message}";
        }
    }

    private async Task ExportToAdtAsync()
    {
        if (timeSlots == null || !timeSlots.Any())
            return;

        try
        {
            var filePath = await AdtExportService.ExportToXmlAsync(timeSlots, selectedDate);
            errorMessage = $"✅ Exported to: {filePath}";
            Console.WriteLine($"Successfully exported to ADT: {filePath}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to export to ADT: {ex.Message}");
            errorMessage = $"Failed to export: {ex.Message}";
        }
    }

    private void MergeWithAbove(AdtExportEntry entry)
    {
        if (timeSlots == null || exportPreview == null) return;

        var currentIndex = exportPreview.ToList().IndexOf(entry);
        if (currentIndex <= 0) return; // Can't merge with above if first item

        var aboveEntry = exportPreview[currentIndex - 1];
        MergeTimeSlots(aboveEntry.TimeSlot, entry.TimeSlot);
    }

    private void MergeWithBelow(AdtExportEntry entry)
    {
        if (timeSlots == null || exportPreview == null) return;

        var currentIndex = exportPreview.ToList().IndexOf(entry);
        if (currentIndex < 0 || currentIndex >= exportPreview.Count - 1) return; // Can't merge with below if last item

        var belowEntry = exportPreview[currentIndex + 1];
        MergeTimeSlots(entry.TimeSlot, belowEntry.TimeSlot);
    }

    private void MergeTimeSlots(TimeSlot first, TimeSlot second)
    {
        if (timeSlots == null) return;

        // Create merged time slot
        var merged = first with
        {
            EndTime = second.EndTime,
            Text = string.IsNullOrEmpty(first.Text) ? second.Text : first.Text, // Keep first text if available
            TicketNr = string.IsNullOrEmpty(first.TicketNr) ? second.TicketNr : first.TicketNr // Keep first ticket if available
        };

        // Rebuild timeSlots list with merged slot
        var slotsList = timeSlots.ToList();
        var firstIndex = slotsList.IndexOf(first);
        var secondIndex = slotsList.IndexOf(second);

        if (firstIndex >= 0 && secondIndex >= 0)
        {
            // Remove both original slots
            slotsList.RemoveAt(Math.Max(firstIndex, secondIndex)); // Remove higher index first
            slotsList.RemoveAt(Math.Min(firstIndex, secondIndex));

            // Insert merged slot at the position of the first slot
            slotsList.Insert(Math.Min(firstIndex, secondIndex), merged);

            // Update timeSlots and regenerate export preview
            timeSlots = slotsList;
            exportPreview = AdtExportService.GetExportPreview(timeSlots, selectedDate);
            excludedCount = timeSlots.Count(ts => ts.Category == TimeSlotCategory.Break);

            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _loadCancellationTokenSource?.Cancel();
        _loadCancellationTokenSource?.Dispose();
    }
}
