@page "/"
@inject EventAggregatorService EventAggregator
@inject EventToTimeSpanConverter TimeSlotConverter
@inject AdtXmlExportService AdtExportService
@inject ClipboardFormatterService ClipboardFormatter
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="home-container">
    <div class="page-header">
        <h1>Daily Activity Tracker</h1>
        <a class="btn" href="/settings" title="Settings">⚙️ Settings</a>
    </div>
    <p>Track your daily activities from Windows events and Git history</p>

    <div class="controls">
        <!-- Date Navigation Section -->
        <div class="date-section">
            <button class="nav-arrow" @onclick="() => LoadDateAsync(selectedDate.AddDays(-1))" title="Previous Day">
                ◀
            </button>
            <input type="date"
                   @bind="selectedDate"
                   @bind:after="LoadEventsAsync"
                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                   class="date-input" />
            <button class="nav-arrow" @onclick="() => LoadDateAsync(selectedDate.AddDays(1))" title="Next Day" disabled="@(selectedDate >= DateTime.Today)">
                ▶
            </button>
            <button class="quick-date-btn" @onclick="() => LoadDateAsync(DateTime.Today.AddDays(-1))" title="Yesterday">Yesterday</button>
            <button class="quick-date-btn" @onclick="() => LoadDateAsync(DateTime.Today)" title="Today">Today</button>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
            <button class="btn btn-refresh" @onclick="LoadEventsAsync" disabled="@isLoading">
                @(isLoading ? "Loading..." : "🔄 Refresh")
            </button>
            <button class="btn btn-copy" @onclick="CopyEventsAsync" disabled="@(events.Count == 0)" title="Copy Events to Clipboard">
                📋 Copy Events
            </button>
            <button class="btn btn-copy" @onclick="CopyTimeSlotsAsync" disabled="@(timeSlots.Count == 0)" title="Copy Time Slots to Clipboard">
                ⏱️ Copy Slots
            </button>
            <button class="btn btn-export" @onclick="ExportToAdtAsync" disabled="@(timeSlots.Count == 0)" title="Export to ADT XML">
                📤 Export to ADT
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-message">
            @errorMessage
        </div>
    }

    @if (availableSources != null && availableSources.Any())
    {
        <div class="sources-info">
            <strong>Active Sources:</strong> @string.Join(", ", availableSources)
        </div>
    }

    <div class="view-switcher">
        <button class="view-btn @(currentView == ViewMode.Events ? "active" : "")" @onclick="() => currentView = ViewMode.Events">
            📋 Events
        </button>
        <button class="view-btn @(currentView == ViewMode.TimeSlots ? "active" : "")" @onclick="() => currentView = ViewMode.TimeSlots">
            ⏱️ Time Slots
        </button>
        <button class="view-btn @(currentView == ViewMode.ExportPreview ? "active" : "")" @onclick="() => currentView = ViewMode.ExportPreview">
            📤 Export Preview
        </button>
    </div>

    @if (currentView == ViewMode.Events)
    {
        <EventList Events="@events" IsLoading="@isLoading" />
    }
    else if (currentView == ViewMode.TimeSlots)
    {
        <TimeSlotList TimeSlots="@timeSlots" IsLoading="@isLoading" />
    }
    else
    {
        <AdtExportPreview
            ExportEntries="@exportPreview"
            IsLoading="@isLoading"
            ExcludedCount="@excludedCount"
            OnMergeAbove="@(e => MergeAdjacent(e, -1))"
            OnMergeBelow="@(e => MergeAdjacent(e, 1))" />
    }
</div>

@code {
    private enum ViewMode { Events, TimeSlots, ExportPreview }

    private DateTime selectedDate = DateTime.Today.AddDays(-1);
    private IReadOnlyList<Event> events = [];
    private IReadOnlyList<TimeSlot> timeSlots = [];
    private IReadOnlyList<AdtExportEntry> exportPreview = [];
    private int excludedCount;
    private IEnumerable<string>? availableSources;
    private bool isLoading;
    private string? errorMessage;
    private CancellationTokenSource? _loadCancellationTokenSource;
    private ViewMode currentView = ViewMode.ExportPreview;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            availableSources = await EventAggregator.GetAvailableSourcesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading sources: {ex.Message}";
        }

        await LoadEventsAsync();
    }

    private async Task LoadEventsAsync()
    {
        _loadCancellationTokenSource?.Cancel();
        _loadCancellationTokenSource?.Dispose();
        _loadCancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = _loadCancellationTokenSource.Token;

        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            events = await EventAggregator.GetEventsForDayAsync(selectedDate, cancellationToken);
            SetTimeSlots(await TimeSlotConverter.ConvertEventsToTimeSlotsAsync(events, cancellationToken));
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer load
        }
        catch (Exception ex)
        {
            Serilog.Log.Error(ex, "Error loading events for {Date}", selectedDate);
            errorMessage = $"Error loading events: {ex.Message}";
            events = [];
            SetTimeSlots([]);
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested)
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private void SetTimeSlots(IReadOnlyList<TimeSlot> slots)
    {
        timeSlots = slots;
        exportPreview = AdtExportService.GetExportPreview(timeSlots, selectedDate);
        excludedCount = timeSlots.Count - exportPreview.Count;
    }

    private Task LoadDateAsync(DateTime date)
    {
        selectedDate = date > DateTime.Today ? DateTime.Today : date;
        return LoadEventsAsync();
    }

    private Task CopyEventsAsync() => CopyToClipboardAsync(ClipboardFormatter.FormatEvents(events, selectedDate));

    private Task CopyTimeSlotsAsync() => CopyToClipboardAsync(ClipboardFormatter.FormatTimeSlots(timeSlots, selectedDate));

    private async Task CopyToClipboardAsync(string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (JSException ex)
        {
            errorMessage = $"Failed to copy to clipboard: {ex.Message}";
        }
    }

    private async Task ExportToAdtAsync()
    {
        try
        {
            var filePath = await AdtExportService.ExportToXmlAsync(timeSlots, selectedDate);
            errorMessage = $"✅ Exported to: {filePath}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to export: {ex.Message}";
        }
    }

    /// <summary>
    /// Merge the time slot of an export entry with its neighbour (-1 = above, 1 = below).
    /// </summary>
    private void MergeAdjacent(AdtExportEntry entry, int direction)
    {
        var index = exportPreview.ToList().IndexOf(entry);
        var neighbourIndex = index + direction;
        if (index < 0 || neighbourIndex < 0 || neighbourIndex >= exportPreview.Count)
            return;

        var first = exportPreview[Math.Min(index, neighbourIndex)].TimeSlot;
        var second = exportPreview[Math.Max(index, neighbourIndex)].TimeSlot;

        var slots = timeSlots.ToList();
        var firstIndex = slots.IndexOf(first);
        var secondIndex = slots.IndexOf(second);
        if (firstIndex < 0 || secondIndex < 0)
            return;

        var merged = first with
        {
            EndTime = second.EndTime,
            Text = string.IsNullOrEmpty(first.Text) ? second.Text : first.Text,
            TicketNr = string.IsNullOrEmpty(first.TicketNr) ? second.TicketNr : first.TicketNr
        };

        slots.RemoveAt(Math.Max(firstIndex, secondIndex));
        slots.RemoveAt(Math.Min(firstIndex, secondIndex));
        slots.Insert(Math.Min(firstIndex, secondIndex), merged);
        SetTimeSlots(slots);
    }

    public void Dispose()
    {
        _loadCancellationTokenSource?.Cancel();
        _loadCancellationTokenSource?.Dispose();
    }
}

